# SERVER ONLY. Never expose this key in Vite define or VITE_ variables.
GEMINI_API_KEY=replace-with-server-only-key
GEMINI_MODEL=gemini-2.5-flash
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORT=8787
# Firebase Admin uses Application Default Credentials.
# For local-only development, set GOOGLE_APPLICATION_CREDENTIALS
# to the absolute path of a local service-account JSON file.
# Never commit service account files or real patient information.
